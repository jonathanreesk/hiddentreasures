---
import Icon from './Icon.astro';
interface Props { items: readonly { q: string; a: string }[] }
const { items } = Astro.props;
---
<div>
  {items.map((f, i) => (
    <details class="faq" open={i === 0}>
      <summary>{f.q}<span class="chev" style="color:var(--red)"><Icon name="plus" size={22} /></span></summary>
      <p>{f.a}</p>
    </details>
  ))}
  <div style="border-top:1px solid rgba(35,31,27,.16)"></div>
</div>
