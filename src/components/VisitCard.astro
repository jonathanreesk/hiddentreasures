---
import { reader } from '../lib/content';
import TagSale from './TagSale.astro';
import Icon from './Icon.astro';
const s = await reader.singletons.settings.read();
const tel = s?.phone?.replace(/\D/g, '');
---
<section class="wrap visit" aria-label="Hours and location">
  <div class="visit-box">
  <div class="card info">
    <div>
      <div class="status" data-status data-days={(s?.openDays ?? []).join(',')} data-open={s?.openHour ?? 10} data-close={s?.closeHour ?? 19}>
        <span class="dotc"></span><span class="label" data-status-label style="color:var(--ink-2)">Store hours</span>
      </div>
      <p class="t">Shop</p>
      {s?.shopHours.map((h) => <p>{h.days}: {h.hours}</p>)}
    </div>
    <div>
      <span class="label" style="color:var(--ink-2)">Drop off</span>
      <p class="t">Donations</p>
      {s?.donateHours.map((h) => <p>{h.days}: {h.hours}</p>)}
    </div>
    <div>
      <span class="label" style="color:var(--ink-2)">Find us</span>
      <p class="t">{s?.addressLine1}</p>
      <p>{s?.addressLine2}</p>
      {s?.mapsUrl && <p><a href={s.mapsUrl} style="font-weight:700">Get directions</a></p>}
    </div>
    <div class="dark">
      <span class="label" style="color:var(--blue)">Questions?</span>
      <p class="t"><a class="tel" href={`tel:${tel}`} aria-label={`Call ${s?.phone}`}><Icon name="phone" size={16} /><span>{s?.phone}</span></a></p>
      <p><a href={`mailto:${s?.email}`} aria-label={`Email ${s?.email}`}><span class="email-full">{s?.email}</span><span class="email-short">Email us</span></a></p>
    </div>
  </div>
  <TagSale />
  </div>
</section>
