---
// Quick edits for store staff: one shared password, one task at a time.
// The server side is src/pages/api/edit.ts (saves) and src/pages/api/edit-upload.ts (video files).
import '../styles/global.css';
const sections = [
  { id: 'events', icon: '📅', name: 'Events and sales' },
  { id: 'ribbon', icon: '📣', name: 'Top ribbon' },
  { id: 'tags', icon: '🏷️', name: 'Tag sale' },
  { id: 'gallery', icon: '🖼️', name: 'Photos and videos' },
  { id: 'slides', icon: '🎞️', name: 'Homepage slides' },
  { id: 'video', icon: '🎬', name: 'Homepage video' },
  { id: 'hours', icon: '🕘', name: 'Hours' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Quick edits | Hidden Treasures</title>
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&family=Open+Sans:wght@400;600;700&family=Young+Serif&display=swap" rel="stylesheet" />
</head>
<body class="qe">
  <header class="qe-top">
    <div class="qe-wrap qe-top-in">
      <a href="/edit" class="qe-brand" data-go-home><img src="/images/brand/wordmark-red.png" alt="Hidden Treasures Thrift Store" width="284" height="56" /> <em>Quick edits</em></a>
      <div class="qe-top-links" data-when-in hidden>
        <a href="/" target="_blank" rel="noopener">View the site ↗</a>
        <button type="button" data-logout>Log out</button>
      </div>
    </div>
  </header>

  <!-- Log in -->
  <main class="qe-wrap" data-login hidden>
    <form class="qe-card qe-login" data-login-form>
      <h1>Welcome back</h1>
      <p class="muted">Enter the staff password to update the website.</p>
      <label class="qe-field"><span>Password</span><input type="password" name="password" autocomplete="current-password" required autofocus /></label>
      <p class="qe-error" data-login-error hidden></p>
      <button class="btn btn-red qe-wide" type="submit">Log in</button>
      <p class="muted qe-small">You'll stay logged in on this device for a week.</p>
    </form>
  </main>

  <main class="qe-wrap" data-app hidden>
    <!-- Home: one tile per task -->
    <div data-home>
      <h1 class="qe-title">What would you like to update?</h1>
      <p class="qe-loading" data-loading>Loading what's on the site…</p>
      <div class="qe-home-grid" data-tiles-home hidden>
        {sections.map((s) => (
          <a class="qe-home-tile" href={`#${s.id}`}>
            <span class="qe-home-icon" aria-hidden="true">{s.icon}</span>
            <span class="qe-home-name">{s.name}</span>
            <span class="qe-home-status" data-status-for={s.id}></span>
          </a>
        ))}
      </div>
      <p class="muted qe-small qe-foot">For changes to page text or partners, ask Jonathan.</p>
    </div>

    <!-- Back bar shown inside a section -->
    <div class="qe-back" data-back hidden><button type="button" data-back-btn>← All updates</button></div>

    <!-- EVENTS -->
    <section class="qe-card" id="events" hidden data-section>
      <header><h2>📅 Events and sales</h2><button class="btn btn-red qe-sm" type="button" data-new-event>+ Add an event or sale</button></header>
      <p class="muted">Events drop off the site 2 days after they end, so there's no need to delete old ones.</p>
      <ul class="qe-list" data-events></ul>
      <button type="button" class="qe-link" data-show-old hidden></button>
      <form class="qe-sub" data-event-form hidden>
        <div class="qe-sub-head"><h3 data-event-heading>New event or sale</h3><button type="button" class="qe-x" data-cancel aria-label="Close">✕</button></div>
        <div class="qe-grid">
          <label class="qe-field qe-span"><span>Name *</span><input name="title" required maxlength="140" placeholder="For example: Half off all books" /></label>
          <label class="qe-field"><span>Kind</span>
            <select name="kind"><option value="sale">Sale</option><option value="event">Event</option><option value="closed">Store closed</option><option value="news">News update</option></select></label>
          <label class="qe-field"><span>Date *</span><input type="date" name="startDate" required /></label>
          <label class="qe-field"><span>Last day, if it runs several days</span><input type="date" name="endDate" /></label>
          <label class="qe-field"><span>Time</span><input name="timeText" maxlength="120" placeholder="10am to 7pm, or All day" /></label>
          <label class="qe-field qe-span"><span>Summary</span><input name="summary" maxlength="300" placeholder="One line for lists and the homepage" /></label>
          <label class="qe-field qe-span"><span>More details</span><textarea name="body" rows="4" maxlength="5000" placeholder="Anything the summary doesn't cover. Leave a blank line between paragraphs."></textarea></label>
          <div class="qe-field qe-span"><span>Photo or flyer</span><div class="qe-photo" data-photo="image"></div></div>
          <label class="qe-field"><span>Where</span><input name="location" maxlength="120" placeholder="Main store" /></label>
          <label class="qe-field"><span>YouTube link</span><input name="videoUrl" type="url" placeholder="https://" /></label>
          <label class="qe-check qe-span"><input type="checkbox" name="pinned" /> Feature it as the big card on the homepage</label>
        </div>
        <div class="qe-actions"><button class="btn btn-red" type="submit">Save</button><button class="btn btn-outline" type="button" data-cancel>Cancel</button></div>
      </form>
    </section>

    <!-- RIBBON -->
    <section class="qe-card" id="ribbon" hidden data-section>
      <header><h2>📣 Top ribbon</h2><span class="qe-pill" data-ribbon-status></span></header>
      <p class="muted">The red bar across the top of every page. Good for "Closed today" or a big sale.</p>
      <form data-ribbon-form>
        <label class="qe-check"><input type="checkbox" name="enabled" /> <strong>Show the ribbon</strong></label>
        <div class="qe-grid">
          <label class="qe-field"><span>Label</span><input name="label" maxlength="40" placeholder="Now open" /></label>
          <label class="qe-field"><span>End date</span><input type="date" name="hideAfter" /><small class="muted">It disappears by itself after this day.</small></label>
          <label class="qe-field qe-span"><span>Message <em class="qe-count" data-count></em></span><input name="message" maxlength="300" placeholder="One short sentence" /></label>
          <label class="qe-field"><span>Link text</span><input name="linkText" maxlength="40" placeholder="Details" /></label>
          <label class="qe-field"><span>Link goes to</span><input name="linkUrl" maxlength="500" placeholder="/news" /></label>
        </div>
        <p class="label qe-prev-label">On a computer</p>
        <p class="qe-preview" data-ribbon-preview></p>
        <p class="label qe-prev-label">On a phone</p>
        <p class="qe-preview qe-preview-phone" data-ribbon-phone></p>
        <div class="qe-actions"><button class="btn btn-red" type="submit">Save ribbon</button></div>
      </form>
    </section>

    <!-- TAG SALE -->
    <section class="qe-card" id="tags" hidden data-section>
      <header><h2>🏷️ Tag sale</h2><span class="qe-pill" data-tag-status></span></header>
      <p class="muted">One row per week. Only the current week shows on the site.</p>
      <form data-tag-form>
        <label class="qe-check"><input type="checkbox" name="enabled" /> <strong>Show this week's tag sale on the site</strong></label>
        <div class="qe-weeks" data-weeks></div>
        <button type="button" class="qe-link" data-show-past-weeks hidden></button>
        <div class="qe-actions"><button type="button" class="btn btn-outline" data-add-week>+ Add the next week</button><button class="btn btn-red" type="submit">Save tag sale</button></div>
      </form>
    </section>

    <!-- GALLERY -->
    <section class="qe-card" id="gallery" hidden data-section>
      <header><h2>🖼️ Photos and videos</h2><span class="qe-pill" data-gallery-status></span></header>
      <p class="muted">Everything here shows on the Gallery page. Tick <strong>⭐ Homepage</strong> on up to 5 photos to show them on the homepage too.</p>
      <div class="qe-actions" style="margin-top:0">
        <label class="btn btn-red">📷 Add photos<input type="file" accept="image/*" multiple hidden data-add-photos /></label>
        <label class="btn btn-outline">🎬 Upload a video<input type="file" accept="video/*" hidden data-upload-video /></label>
        <button type="button" class="btn btn-outline" data-add-video>🔗 Paste a YouTube link</button>
      </div>
      <p class="qe-note" data-gallery-progress hidden></p>
      <div class="qe-tiles" data-tiles></div>
      <div class="qe-actions"><button type="button" class="btn btn-red" data-save-gallery>Save photos and videos</button></div>
    </section>

    <!-- SLIDES -->
    <section class="qe-card" id="slides" hidden data-section>
      <header><h2>🎞️ Homepage slides</h2><span class="qe-pill" data-slides-status></span></header>
      <p class="muted">The big rotating pictures at the top of the homepage. Give seasonal slides an end date and they'll disappear by themselves.</p>
      <div data-slides></div>
      <div class="qe-actions"><button type="button" class="btn btn-outline" data-add-slide>+ Add a slide</button><button type="button" class="btn btn-red" data-save-slides>Save slides</button></div>
    </section>

    <!-- VIDEO -->
    <section class="qe-card" id="video" hidden data-section>
      <header><h2>🎬 Homepage video</h2><span class="qe-pill" data-video-status></span></header>
      <p class="muted">A video below the homepage slides. When there's no video, a gallery photo shows in its place.</p>
      <form data-video-form>
        <label class="qe-check"><input type="checkbox" name="show" /> <strong>Show the video</strong></label>
        <p class="qe-note" data-upload-note hidden></p>
        <div class="qe-grid">
          <div class="qe-field qe-span"><span>Video</span><div class="qe-photo"><label class="btn btn-outline qe-sm">🎬 Upload a video<input type="file" accept="video/*" hidden data-home-video /></label><span class="muted qe-small" data-home-video-name></span></div></div>
          <label class="qe-field qe-span"><span>Or paste a YouTube link</span><input name="youtube" type="url" placeholder="https://www.youtube.com/watch?v=…" /></label>
          <label class="qe-field qe-span"><span>Headline</span><input name="title" maxlength="120" /></label>
          <label class="qe-field qe-span"><span>A sentence or two</span><textarea name="text" rows="2" maxlength="600"></textarea></label>
          <div class="qe-field qe-span"><span>Cover photo</span><div class="qe-photo" data-photo="cover"></div></div>
          <label class="qe-field"><span>Button text</span><input name="buttonText" maxlength="40" /></label>
          <label class="qe-field"><span>Button link</span><input name="buttonLink" maxlength="500" placeholder="/news" /></label>
          <label class="qe-field"><span>End date</span><input type="date" name="hideAfter" /><small class="muted">The photo takes its place after this day.</small></label>
        </div>
        <div class="qe-actions"><button class="btn btn-red" type="submit">Save video</button></div>
      </form>
    </section>

    <!-- HOURS -->
    <section class="qe-card" id="hours" hidden data-section>
      <header><h2>🕘 Hours</h2></header>
      <form data-hours-form>
        <div class="qe-two">
          <fieldset class="qe-hours" data-hours="shop">
            <legend>Shop</legend>
            <div class="qe-days" data-days></div>
            <div class="qe-grid qe-grid-2"><label class="qe-field"><span>Opens</span><select data-open></select></label><label class="qe-field"><span>Closes</span><select data-close></select></label></div>
            <p class="qe-says" data-says></p>
          </fieldset>
          <fieldset class="qe-hours" data-hours="drop">
            <legend>Donation drop-off</legend>
            <div class="qe-days" data-days></div>
            <div class="qe-grid qe-grid-2"><label class="qe-field"><span>Opens</span><select data-open></select></label><label class="qe-field"><span>Closes</span><select data-close></select></label></div>
            <p class="qe-says" data-says></p>
          </fieldset>
        </div>
        <div class="qe-grid">
          <label class="qe-field"><span>Phone</span><input name="phone" maxlength="40" /></label>
          <label class="qe-field"><span>Email</span><input name="email" type="email" maxlength="120" /></label>
        </div>
        <div class="qe-actions"><button class="btn btn-red" type="submit">Save hours</button></div>
      </form>
    </section>
  </main>

  <div class="qe-toast" data-toast hidden></div>

  <script>
    import { upload } from '@vercel/blob/client';
    type Any = any;
    const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => el.querySelector(s) as T;
    const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => [...el.querySelectorAll(s)] as T[];
    const field = (f: HTMLFormElement, n: string) => f.elements.namedItem(n) as HTMLInputElement;
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const nice = (d?: string) => (d ? `${MONTHS[+d.slice(5, 7) - 1]} ${+d.slice(8, 10)}` : '');
    const range = (a?: string, b?: string | null) => (b && b !== a ? `${nice(a)} to ${nice(b)}` : nice(a));
    const today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Chicago' });
    const addDays = (d: string, n: number) => new Date(Date.parse(d + 'T12:00:00Z') + n * 86400000).toISOString().slice(0, 10);
    const daysBetween = (a: string, b: string) => Math.round((Date.parse(a + 'T00:00:00Z') - Date.parse(b + 'T00:00:00Z')) / 86400000);
    const TAGS: Record<string, string> = { blue: '#3e5f9e', green: '#3f8f4f', red: '#a33749', yellow: '#f2c94c', orange: '#c45d3b', purple: '#6b4c9a', pink: '#e58fb2', white: '#ffffff' };
    const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
    const pill = (el: HTMLElement, text: string, cls: string) => { el.textContent = text; el.className = 'qe-pill ' + cls; };
    let state: Any = {};

    async function api(action: string, payload: Any = {}) {
      const res = await fetch('/api/edit', { method: 'POST', headers: { 'content-type': 'application/json', 'x-ht-edit': '1' }, body: JSON.stringify({ action, ...payload }), credentials: 'same-origin' });
      const j = await res.json().catch(() => ({ ok: false, error: 'Something went wrong. Please try again.' }));
      if (res.status === 401 && action !== 'login') showLogin();
      return j;
    }
    function toast(msg: string, bad = false) {
      const t = $('[data-toast]');
      t.textContent = msg; t.className = 'qe-toast' + (bad ? ' bad' : ''); t.hidden = false;
      clearTimeout((t as Any)._t); (t as Any)._t = setTimeout(() => (t.hidden = true), bad ? 7000 : 4500);
    }
    async function busy(btn: HTMLButtonElement | null, fn: () => Promise<void>) {
      if (btn) { btn.disabled = true; (btn as Any)._l = btn.textContent; btn.textContent = 'Saving…'; }
      try { await fn(); } finally { if (btn) { btn.disabled = false; btn.textContent = (btn as Any)._l; } }
    }
    // After a save: say when it goes live, clear the unsaved flag and refresh
    const saved = (j: Any) => { if (j.ok) { toast('Saved. It will be live on the site in about a minute.'); dirty = false; load(); } else toast(j.error || 'Could not save.', true); return j.ok; };

    // ---------------------------------------------------------------- unsaved changes
    let dirty = false;
    document.addEventListener('input', (e) => { if ((e.target as HTMLElement).closest('[data-section], [data-event-form]')) dirty = true; });
    window.addEventListener('beforeunload', (e) => { if (dirty) { e.preventDefault(); e.returnValue = ''; } });
    const okToLeave = () => !dirty || confirm('You have changes that are not saved. Leave without saving?');

    // ---------------------------------------------------------------- one section at a time
    let current = '';
    function route() {
      const id = location.hash.slice(1);
      const sec = id && document.getElementById(id);
      const inSection = !!(sec && sec.hasAttribute('data-section'));
      $('[data-home]').hidden = inSection;
      $('[data-back]').hidden = !inSection;
      $$('[data-section]').forEach((s) => (s.hidden = s !== sec));
      current = inSection ? id : '';
      window.scrollTo(0, 0);
    }
    window.addEventListener('hashchange', () => {
      if (dirty && current && location.hash.slice(1) !== current) {
        if (!okToLeave()) { history.replaceState(null, '', '#' + current); return; }
        dirty = false; load();
      }
      route();
    });
    const goHome = () => { if (!okToLeave()) return; dirty = false; closeEvent(); history.pushState(null, '', '/edit'); route(); load(); };
    $('[data-back-btn]').addEventListener('click', goHome);
    $('[data-go-home]').addEventListener('click', (e) => { if ($('[data-app]').hidden) return; e.preventDefault(); goHome(); });

    // ---------------------------------------------------------------- login
    function showLogin() { $('[data-login]').hidden = false; $('[data-app]').hidden = true; $('[data-when-in]').hidden = true; }
    async function showApp() { $('[data-login]').hidden = true; $('[data-app]').hidden = false; $('[data-when-in]').hidden = false; route(); await load(); }
    $('[data-login-form]').addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.currentTarget as HTMLFormElement, err = $('[data-login-error]');
      err.hidden = true;
      await busy($('button[type=submit]', f) as HTMLButtonElement, async () => {
        const j = await api('login', { password: field(f, 'password').value });
        if (j.ok) { f.reset(); showApp(); } else { err.textContent = j.error; err.hidden = false; }
      });
    });
    $('[data-logout]').addEventListener('click', async () => { if (!okToLeave()) return; dirty = false; await api('logout'); showLogin(); });

    // ---------------------------------------------------------------- photos
    function resize(file: File): Promise<string> {
      return new Promise((ok, bad) => {
        const im = new Image();
        im.onload = () => {
          const max = 1800, s = Math.min(1, max / Math.max(im.width, im.height));
          const c = document.createElement('canvas'); c.width = Math.round(im.width * s); c.height = Math.round(im.height * s);
          c.getContext('2d')!.drawImage(im, 0, 0, c.width, c.height);
          ok(c.toDataURL('image/jpeg', 0.85)); URL.revokeObjectURL(im.src);
        };
        im.onerror = () => bad(new Error("That file isn't a photo we can read."));
        im.src = URL.createObjectURL(file);
      });
    }
    async function uploadPhoto(file: File) {
      try { const data = await resize(file); const j = await api('upload', { name: file.name, data }); if (j.ok) return { path: j.path as string, data }; toast(j.error, true); }
      catch (e: Any) { toast(e.message, true); }
      return null;
    }
    // A photo picker. onChange runs whenever the photo is added, replaced or removed.
    function photoField(box: HTMLElement, value: string | null, preview?: string, onChange?: (v: string | null, pv?: string) => void) {
      (box as Any).value = value || null;
      const draw = (pv?: string) => {
        const v = (box as Any).value;
        box.innerHTML = v
          ? `<img src="${esc(pv || v)}" alt="" /><div><label class="btn btn-outline qe-sm">Replace<input type="file" accept="image/*" hidden /></label> <button type="button" class="qe-link" data-remove>Remove</button></div>`
          : `<label class="qe-drop">📷 Choose a photo<input type="file" accept="image/*" hidden /></label>`;
        const input = $('input[type=file]', box) as HTMLInputElement;
        input.onchange = async () => {
          const file = input.files?.[0]; if (!file) return;
          box.classList.add('loading');
          const r = await uploadPhoto(file);
          box.classList.remove('loading');
          if (r) { (box as Any).value = r.path; dirty = true; onChange?.(r.path, r.data); draw(r.data); }
        };
        const rm = $('[data-remove]', box); if (rm) rm.onclick = () => { (box as Any).value = null; dirty = true; onChange?.(null); draw(); };
      };
      draw(preview);
    }

    // ---------------------------------------------------------------- videos (straight to Vercel Blob storage)
    async function uploadVideo(file: File, onPct: (p: number) => void): Promise<string | null> {
      if (!file.type.startsWith('video/')) { toast('Please choose a video file (MP4 or MOV).', true); return null; }
      if (file.size > 500 * 1024 * 1024) { toast('That video is over 500 MB. Please trim it, or put it on YouTube and paste the link.', true); return null; }
      const ready = await fetch('/api/edit-upload').then((r) => r.json()).catch(() => ({ ready: false }));
      if (!ready.ready) { toast("Video uploads aren't switched on yet. For now, put it on YouTube and paste the link.", true); return null; }
      try {
        const safe = file.name.toLowerCase().replace(/[^a-z0-9.]+/g, '-');
        const blob = await upload(`videos/${safe}`, file, { access: 'public', handleUploadUrl: '/api/edit-upload', multipart: file.size > 20 * 1024 * 1024, onUploadProgress: (e) => onPct(Math.round(e.percentage)) });
        return blob.url;
      } catch (e: Any) {
        toast(/log in/i.test(e?.message || '') ? e.message : "The video didn't upload. Check your connection and try again.", true);
        return null;
      }
    }
    // A still from the video becomes its cover photo
    function videoFrame(file: File): Promise<string | null> {
      return new Promise((ok) => {
        const v = document.createElement('video'); v.muted = true; v.playsInline = true; v.preload = 'auto';
        v.src = URL.createObjectURL(file);
        let done = false; const end = (r: string | null) => { if (done) return; done = true; URL.revokeObjectURL(v.src); ok(r); };
        v.onloadeddata = () => { v.currentTime = Math.min(1.5, (v.duration || 2) / 3); };
        v.onseeked = () => {
          const s = Math.min(1, 1600 / Math.max(v.videoWidth, v.videoHeight));
          const c = document.createElement('canvas'); c.width = Math.round(v.videoWidth * s); c.height = Math.round(v.videoHeight * s);
          try { c.getContext('2d')!.drawImage(v, 0, 0, c.width, c.height); end(c.toDataURL('image/jpeg', 0.85)); } catch { end(null); }
        };
        v.onerror = () => end(null);
        setTimeout(() => end(null), 15000);
      });
    }
    async function coverFromVideo(file: File) {
      const data = await videoFrame(file); if (!data) return null;
      const j = await api('upload', { name: file.name.replace(/\.\w+$/, '') + '-cover', data });
      return j.ok ? { path: j.path as string, data } : null;
    }

    // ---------------------------------------------------------------- events
    const kindOf = (e: Any) => (e.badge === 'Closed' ? 'closed' : e.type || 'event');
    const kindLabel: Record<string, string> = { sale: 'Sale', event: 'Event', closed: 'Store closed', news: 'News' };
    function statusOf(start: string, end: string): [string, string] {
      if (start <= today && today <= end) return [start === end ? 'Today' : 'Happening now', 'on'];
      if (start > today) return [daysBetween(start, today) === 1 ? 'Tomorrow' : 'Coming up', 'soon'];
      if (daysBetween(today, end) <= 2) return ['Just ended', 'ended'];
      return ['Ended', 'off'];
    }
    let editing: string | null = null;
    const isPhone = () => window.matchMedia('(max-width: 720px)').matches;
    function renderEvents() {
      const ul = $('[data-events]'); let old = 0;
      closeEvent();
      ul.innerHTML = (state.events || []).map((e: Any) => {
        const start = e.startDate || '', end = e.endDate || start;
        const [s, cls] = statusOf(start, end);
        const isOld = cls === 'off'; if (isOld) old++;
        return `<li class="${isOld ? 'old' : ''}" ${isOld ? 'hidden' : ''} data-slug="${esc(e.slug)}">
          <span class="qe-pill ${cls}">${s}</span>
          <div class="qe-main"><strong>${esc(e.title)}</strong><span class="muted">${kindLabel[kindOf(e)]} · ${range(start, e.endDate)}${e.pinned ? ' · ⭐ On the homepage' : ''}</span></div>
          <div class="qe-row-btns"><button type="button" class="qe-edit" data-edit>Edit</button><button type="button" class="qe-del" data-del aria-label="Delete ${esc(e.title)}">Delete</button></div></li>`;
      }).join('') || '<li><span class="muted">No events yet. Tap "+ Add an event or sale" to post one.</span></li>';
      const more = $('[data-show-old]');
      more.hidden = !old; more.textContent = `Show ${old} older event${old === 1 ? '' : 's'}`;
      more.onclick = () => { $$('[data-events] li.old').forEach((li) => (li.hidden = false)); more.hidden = true; };
      $$('[data-events] [data-edit]').forEach((b) => (b.onclick = () => openEvent((b.closest('li') as HTMLElement).dataset.slug!)));
      $$('[data-events] [data-del]').forEach((b) => (b.onclick = async () => {
        const slug = (b.closest('li') as HTMLElement).dataset.slug!, ev = state.events.find((x: Any) => x.slug === slug);
        if (!confirm(`Delete "${ev?.title}"? It will be removed from the website.`)) return;
        await busy(b as HTMLButtonElement, async () => { const j = await api('deleteEvent', { slug }); if (j.ok) { toast('Deleted. The site updates in about a minute.'); load(); } else toast(j.error, true); });
      }));
    }
    function openEvent(slug: string | null) {
      if (dirty && !okToLeave()) return;
      editing = slug;
      const f = $('[data-event-form]') as HTMLFormElement, e: Any = slug ? state.events.find((x: Any) => x.slug === slug) : {};
      f.reset();
      $('[data-event-heading]').textContent = slug ? `Editing: ${e.title}` : 'New event or sale';
      field(f, 'title').value = e.title || '';
      (f.elements.namedItem('kind') as HTMLSelectElement).value = slug ? kindOf(e) : 'sale';
      field(f, 'startDate').value = e.startDate || today;
      field(f, 'endDate').value = e.endDate || '';
      for (const k of ['timeText', 'summary', 'body', 'location', 'videoUrl']) field(f, k).value = e[k] || '';
      field(f, 'pinned').checked = !!e.pinned;
      photoField($('[data-photo="image"]', f), e.image || null);
      // Phones: a full-screen panel. Computers: right under the row that was tapped.
      const phone = isPhone();
      f.classList.toggle('qe-sheet', phone);
      document.body.classList.toggle('qe-locked', phone);
      const li = slug ? $(`[data-events] li[data-slug="${CSS.escape(slug)}"]`) : null;
      if (phone) document.body.appendChild(f);
      else if (li) li.after(f);
      else $('[data-events]').before(f);
      f.hidden = false; dirty = false;
      if (!phone) f.scrollIntoView({ behavior: 'smooth', block: 'start' });
      field(f, 'title').focus({ preventScroll: true });
    }
    function closeEvent() {
      const f = $('[data-event-form]') as HTMLFormElement;
      f.hidden = true; f.classList.remove('qe-sheet'); document.body.classList.remove('qe-locked'); $('#events').appendChild(f); editing = null;
    }
    $('[data-new-event]').addEventListener('click', () => openEvent(null));
    $$('[data-event-form] [data-cancel]').forEach((b) => b.addEventListener('click', () => { if (!okToLeave()) return; dirty = false; closeEvent(); }));
    $('[data-event-form]').addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const f = ev.currentTarget as HTMLFormElement;
      const data: Any = Object.fromEntries(new FormData(f).entries());
      data.pinned = field(f, 'pinned').checked;
      data.image = ($('[data-photo="image"]', f) as Any).value;
      if (data.endDate && data.endDate < data.startDate) return toast('The last day is before the first day. Please check the dates.', true);
      await busy($('button[type=submit]', f) as HTMLButtonElement, async () => { if (saved(await api('saveEvent', { slug: editing, data }))) closeEvent(); });
    });

    // ---------------------------------------------------------------- ribbon
    const PHONE_FIT = 38;
    function ribbonPreview() {
      const f = $('[data-ribbon-form]') as HTMLFormElement;
      const on = field(f, 'enabled').checked, end = field(f, 'hideAfter').value;
      const label = field(f, 'label').value, msg = field(f, 'message').value, link = field(f, 'linkText').value;
      const html = `${label ? `<b class="qe-rb-pill">${esc(label)}</b> ` : ''}<span>${esc(msg)}</span>${link ? ` <u>${esc(link)}</u>` : ''}`;
      const live = on && (!end || end >= today);
      for (const el of [$('[data-ribbon-preview]'), $('[data-ribbon-phone]')]) { el.innerHTML = live ? html : on ? 'Past its end date, so it is hidden.' : 'The ribbon is turned off.'; el.classList.toggle('off', !live); }
      const n = msg.length, c = $('[data-count]');
      c.textContent = n ? `${n} characters${n > PHONE_FIT ? `. Phones show about the first ${PHONE_FIT}.` : ''}` : '';
      c.classList.toggle('warn', n > PHONE_FIT);
    }
    function ribbonStatus(): [string, string] {
      const a = state.announcement || {};
      const live = a.enabled && a.message && (!a.hideAfter || a.hideAfter >= today);
      if (live) return [a.hideAfter ? `Showing until ${nice(a.hideAfter)}` : 'Showing', 'on'];
      return [a.enabled && a.hideAfter && a.hideAfter < today ? `Ended ${nice(a.hideAfter)}` : 'Hidden', 'off'];
    }
    function renderRibbon() {
      const f = $('[data-ribbon-form]') as HTMLFormElement, a = state.announcement || {};
      field(f, 'enabled').checked = !!a.enabled;
      for (const k of ['label', 'message', 'linkText', 'linkUrl', 'hideAfter']) field(f, k).value = a[k] || '';
      const [t, c] = ribbonStatus(); pill($('[data-ribbon-status]'), t, c);
      ribbonPreview();
    }
    $('[data-ribbon-form]').addEventListener('input', ribbonPreview);
    $('[data-ribbon-form]').addEventListener('submit', async (e) => {
      e.preventDefault(); const f = e.currentTarget as HTMLFormElement;
      const data: Any = Object.fromEntries(new FormData(f).entries()); data.enabled = field(f, 'enabled').checked;
      if (data.enabled && !String(data.message).trim()) return toast('Add a message, or untick "Show the ribbon".', true);
      await busy($('button[type=submit]', f) as HTMLButtonElement, async () => { saved(await api('saveAnnouncement', { data })); });
    });

    // ---------------------------------------------------------------- tag sale
    let weeks: Any[] = [];
    const thisWeek = () => weeks.find((w) => w.start <= today && today <= w.end);
    function tagStatus(): [string, string] {
      if (!state.tagSale?.enabled) return ['Hidden', 'off'];
      const w = (state.tagSale?.weeks || []).find((w: Any) => w.start <= today && today <= w.end);
      return w ? [`This week: ${cap(w.color)} tags ${w.discount}`, 'on'] : ['No color set for this week', 'warn'];
    }
    function renderWeeks(showPast = false) {
      const box = $('[data-weeks]'); let past = 0;
      box.innerHTML = weeks.map((w, i) => {
        const isPast = w.end && w.end < today, isNow = w.start <= today && today <= w.end;
        if (isPast) past++;
        return `<div class="qe-week ${isNow ? 'now' : ''}" ${isPast && !showPast ? 'hidden' : ''} data-i="${i}">
          <span class="qe-pill ${isNow ? 'on' : isPast ? 'off' : 'soon'}">${isNow ? 'This week' : isPast ? 'Past' : 'Coming up'}</span>
          <label class="qe-field"><span>From</span><input type="date" data-k="start" value="${esc(w.start)}" /></label>
          <label class="qe-field"><span>To</span><input type="date" data-k="end" value="${esc(w.end)}" /></label>
          <label class="qe-field"><span>Tag color</span><span class="qe-color"><i style="background:${TAGS[w.color] || '#ccc'}"></i><select data-k="color">${Object.keys(TAGS).map((c) => `<option value="${c}" ${c === w.color ? 'selected' : ''}>${cap(c)}</option>`).join('')}</select></span></label>
          <label class="qe-field"><span>Discount</span><input data-k="discount" value="${esc(w.discount)}" placeholder="50% off" /></label>
          <button type="button" class="qe-del" data-rm-week="${i}" aria-label="Remove week">✕</button></div>`;
      }).join('');
      const more = $('[data-show-past-weeks]'); more.hidden = !past || showPast; more.textContent = `Show ${past} past week${past === 1 ? '' : 's'}`; more.onclick = () => renderWeeks(true);
      const [t, c] = tagStatus(); pill($('[data-tag-status]'), t, c);
      $$('[data-weeks] [data-k]').forEach((inp) => (inp.oninput = () => {
        const row = inp.closest('[data-i]') as HTMLElement; const w = weeks[+row.dataset.i!];
        w[(inp as HTMLElement).dataset.k!] = (inp as HTMLInputElement).value;
        if ((inp as HTMLElement).dataset.k === 'color') ($('i', row) as HTMLElement).style.background = TAGS[w.color];
      }));
      $$('[data-rm-week]').forEach((b) => (b.onclick = () => { weeks.splice(+b.dataset.rmWeek!, 1); dirty = true; renderWeeks(showPast); }));
    }
    $('[data-add-week]').addEventListener('click', () => {
      const last = weeks[weeks.length - 1];
      let start = last?.end ? addDays(last.end, 1) : today;
      if (start < today && !thisWeek()) { const d = new Date(Date.parse(today + 'T12:00:00Z')); start = addDays(today, -d.getUTCDay()); }
      weeks.push({ start, end: addDays(start, 6), color: last?.color || 'blue', discount: last?.discount || '50% off' });
      dirty = true; renderWeeks(); toast('Week added. Pick the color, then tap "Save tag sale".');
    });
    $('[data-tag-form]').addEventListener('submit', async (e) => {
      e.preventDefault(); const f = e.currentTarget as HTMLFormElement;
      if (weeks.some((w) => !w.start || !w.end || w.end < w.start)) return toast('Please check the dates. Each week needs a "From" and a "To".', true);
      await busy($('button[type=submit]', f) as HTMLButtonElement, async () => { saved(await api('saveTagSale', { data: { enabled: field(f, 'enabled').checked, weeks } })); });
    });

    // ---------------------------------------------------------------- photos and videos
    let gallery: Any[] = [];
    const MAX_FEATURED = 5;
    const galleryStatus = (): [string, string] => { const n = gallery.filter((g) => g.featured).length; return [`${gallery.length} items, ${n} on the homepage`, n ? 'on' : 'warn']; };
    function renderGallery() {
      const box = $('[data-tiles]');
      box.innerHTML = gallery.map((g, i) => {
        const isVideo = !!(g.videoUrl || g.videoUpload);
        return `<div class="qe-tile ${g.featured ? 'feat' : ''}" data-g="${i}">
          <div class="qe-thumb">${g.image ? `<img src="${esc(g._preview || g.image)}" alt="" loading="lazy" />` : '<span>No cover photo</span>'}${isVideo ? '<b class="qe-play">▶ Video</b>' : ''}</div>
          <input class="qe-caption" data-gk="caption" value="${esc(g.caption)}" maxlength="140" placeholder="Add a caption" aria-label="Caption" />
          ${isVideo && !g.videoUpload ? `<input class="qe-caption" data-gk="videoUrl" value="${esc(g.videoUrl || '')}" placeholder="YouTube link" aria-label="YouTube link" />` : ''}
          ${!isVideo && g.image ? `<label class="qe-star"><input type="checkbox" data-gk="featured" ${g.featured ? 'checked' : ''} /> ⭐ Homepage</label>` : ''}
          <div class="qe-tile-tools">
            <button type="button" data-move="-1" ${i === 0 ? 'disabled' : ''} aria-label="Move earlier">←</button>
            <button type="button" data-move="1" ${i === gallery.length - 1 ? 'disabled' : ''} aria-label="Move later">→</button>
            <label class="qe-mini">${g.image ? 'Photo' : 'Add cover'}<input type="file" accept="image/*" hidden data-cover /></label>
            <button type="button" class="qe-del" data-gdel aria-label="Remove">✕</button>
          </div></div>`;
      }).join('') || '<p class="muted">No photos yet. Tap "Add photos" to start.</p>';
      const [t, c] = galleryStatus(); pill($('[data-gallery-status]'), t, c);
      $$('[data-g]').forEach((tile) => {
        const i = +tile.dataset.g!, g = gallery[i];
        $$('[data-gk]', tile).forEach((inp) => (inp.oninput = inp.onchange = () => {
          const k = (inp as HTMLElement).dataset.gk!;
          if (k === 'featured') {
            const on = (inp as HTMLInputElement).checked;
            if (on && gallery.filter((x) => x.featured).length >= MAX_FEATURED) { (inp as HTMLInputElement).checked = false; return toast(`Only ${MAX_FEATURED} photos fit on the homepage. Untick one first.`, true); }
            g.featured = on; tile.classList.toggle('feat', on); const [t2, c2] = galleryStatus(); pill($('[data-gallery-status]'), t2, c2);
          } else g[k] = (inp as HTMLInputElement).value;
          dirty = true;
        }));
        $$('[data-move]', tile).forEach((b) => (b.onclick = () => { const j = i + +b.dataset.move!; [gallery[i], gallery[j]] = [gallery[j], gallery[i]]; dirty = true; renderGallery(); }));
        ($('[data-gdel]', tile) as HTMLElement).onclick = () => { if (confirm('Remove this from the gallery?')) { gallery.splice(i, 1); dirty = true; renderGallery(); } };
        const cover = $('[data-cover]', tile) as HTMLInputElement;
        cover.onchange = async () => { const f = cover.files?.[0]; if (!f) return; tile.classList.add('loading'); const r = await uploadPhoto(f); tile.classList.remove('loading'); if (r) { g.image = r.path; g._preview = r.data; dirty = true; renderGallery(); } };
      });
    }
    ($('[data-add-photos]') as HTMLInputElement).addEventListener('change', async (e) => {
      const input = e.currentTarget as HTMLInputElement, files = [...(input.files || [])]; input.value = '';
      const prog = $('[data-gallery-progress]'); prog.hidden = false;
      let n = 0;
      for (const f of files) {
        prog.textContent = `Uploading photo ${n + 1} of ${files.length}…`;
        const r = await uploadPhoto(f);
        if (r) { gallery.unshift({ kind: 'photo', image: r.path, _preview: r.data, caption: '', altText: '', featured: false, videoUrl: null, videoUpload: null }); n++; renderGallery(); }
      }
      prog.hidden = true;
      if (n) { dirty = true; toast(`${n} photo${n > 1 ? 's' : ''} added. Add captions, then tap "Save photos and videos".`); }
    });
    ($('[data-upload-video]') as HTMLInputElement).addEventListener('change', async (e) => {
      const input = e.currentTarget as HTMLInputElement, file = input.files?.[0]; input.value = '';
      if (!file) return;
      const prog = $('[data-gallery-progress]'); prog.hidden = false; prog.textContent = 'Uploading video… 0%';
      const url = await uploadVideo(file, (p) => (prog.textContent = `Uploading video… ${p}%. Keep this page open.`));
      if (url) {
        prog.textContent = 'Making a cover photo…';
        const cover = await coverFromVideo(file);
        gallery.unshift({ kind: 'video', image: cover?.path || null, _preview: cover?.data, videoUrl: null, videoUpload: url, caption: '', altText: '', featured: false });
        dirty = true; renderGallery(); toast('Video added. Add a caption, then tap "Save photos and videos".');
      }
      prog.hidden = true;
    });
    $('[data-add-video]').addEventListener('click', () => {
      const link = prompt('Paste the YouTube link:');
      if (!link) return;
      if (!/^https?:\/\/(www\.)?(youtube\.com|youtu\.be|vimeo\.com)\//i.test(link.trim())) return toast("That doesn't look like a YouTube link.", true);
      gallery.unshift({ kind: 'video', image: null, videoUrl: link.trim(), videoUpload: null, caption: '', altText: '', featured: false });
      dirty = true; renderGallery(); toast('Video added. Add a cover photo and a caption, then save.');
    });
    $('[data-save-gallery]').addEventListener('click', async (e) => {
      const items = gallery.map(({ _preview, ...g }) => g);
      await busy(e.currentTarget as HTMLButtonElement, async () => { saved(await api('saveGallery', { data: { items } })); });
    });

    // ---------------------------------------------------------------- homepage slides
    let slides: Any[] = [];
    const slideLive = (s: Any) => !s.hideAfter || s.hideAfter >= today;
    const slidesStatus = (list: Any[]): [string, string] => { const n = list.filter(slideLive).length; return [`${n} showing${list.length > n ? `, ${list.length - n} ended` : ''}`, n ? 'on' : 'warn']; };
    function renderSlides() {
      const box = $('[data-slides]');
      box.innerHTML = slides.map((s, i) => `<div class="qe-slide ${slideLive(s) ? '' : 'ended'}" data-s="${i}">
        <div class="qe-slide-head"><strong>Slide ${i + 1}</strong><span class="qe-pill ${slideLive(s) ? 'on' : 'off'}">${slideLive(s) ? (s.hideAfter ? `Showing until ${nice(s.hideAfter)}` : 'Showing') : `Ended ${nice(s.hideAfter)}`}</span>
          <span class="qe-slide-tools"><button type="button" data-smove="-1" ${i === 0 ? 'disabled' : ''} aria-label="Move up">↑</button><button type="button" data-smove="1" ${i === slides.length - 1 ? 'disabled' : ''} aria-label="Move down">↓</button><button type="button" class="qe-del" data-sdel>Remove</button></span></div>
        <div class="qe-grid">
          <div class="qe-field qe-span"><span>Photo</span><div class="qe-photo" data-sphoto></div></div>
          <label class="qe-field qe-span"><span>Headline *</span><input data-sk="title" value="${esc(s.title)}" maxlength="120" /></label>
          <label class="qe-field"><span>Small text above the headline</span><input data-sk="eyebrow" value="${esc(s.eyebrow)}" maxlength="60" /></label>
          <label class="qe-field"><span>End date</span><input type="date" data-sk="hideAfter" value="${esc(s.hideAfter || '')}" /></label>
          <label class="qe-field qe-span"><span>Text</span><textarea data-sk="body" rows="2" maxlength="400">${esc(s.body)}</textarea></label>
          <label class="qe-field"><span>Main button text</span><input data-sk="primary.label" value="${esc(s.primary?.label)}" maxlength="40" /></label>
          <label class="qe-field"><span>Main button link</span><input data-sk="primary.href" value="${esc(s.primary?.href)}" placeholder="/donate" /></label>
          <label class="qe-field"><span>Second button text</span><input data-sk="secondary.label" value="${esc(s.secondary?.label)}" maxlength="40" /></label>
          <label class="qe-field"><span>Second button link</span><input data-sk="secondary.href" value="${esc(s.secondary?.href)}" placeholder="/visit" /></label>
          <label class="qe-field"><span>Color over the photo</span><select data-sk="tint"><option value="dark" ${s.tint !== 'red' ? 'selected' : ''}>Dark</option><option value="red" ${s.tint === 'red' ? 'selected' : ''}>Brick red</option></select></label>
        </div></div>`).join('');
      const [t, c] = slidesStatus(slides); pill($('[data-slides-status]'), t, c);
      $$('[data-s]').forEach((row) => {
        const i = +row.dataset.s!, s = slides[i];
        photoField($('[data-sphoto]', row), s.image || null, s._preview, (v, pv) => { s.image = v; s._preview = pv; });
        $$('[data-sk]', row).forEach((inp) => (inp.oninput = inp.onchange = () => {
          const [a, b] = (inp as HTMLElement).dataset.sk!.split('.');
          if (b) s[a] = { ...(s[a] || {}), [b]: (inp as HTMLInputElement).value }; else s[a] = (inp as HTMLInputElement).value;
          dirty = true;
        }));
        $$('[data-smove]', row).forEach((b) => (b.onclick = () => { const j = i + +b.dataset.smove!; [slides[i], slides[j]] = [slides[j], slides[i]]; dirty = true; renderSlides(); }));
        ($('[data-sdel]', row) as HTMLElement).onclick = () => { if (slides.length < 2) return toast('Keep at least one slide on the homepage.', true); if (confirm(`Remove slide ${i + 1}?`)) { slides.splice(i, 1); dirty = true; renderSlides(); } };
      });
    }
    $('[data-add-slide]').addEventListener('click', () => {
      slides.push({ title: '', eyebrow: '', body: '', image: null, tint: 'dark', primary: { label: '', href: '' }, secondary: { label: '', href: '' }, hideAfter: '' });
      dirty = true; renderSlides(); ($('[data-s]:last-child [data-sk="title"]') as HTMLInputElement)?.focus();
    });
    $('[data-save-slides]').addEventListener('click', async (e) => {
      if (slides.some((s) => !String(s.title || '').trim())) return toast('Every slide needs a headline.', true);
      const data = { slides: slides.map(({ _preview, ...s }) => s) };
      await busy(e.currentTarget as HTMLButtonElement, async () => { saved(await api('saveSlides', { data })); });
    });

    // ---------------------------------------------------------------- homepage video
    function videoStatus(): [string, string] {
      const v = state.homeVideo || {};
      if (!(v.show && (v.video || v.youtube))) return ['Hidden. A photo shows instead.', 'off'];
      if (v.hideAfter && v.hideAfter < today) return [`Ended ${nice(v.hideAfter)}. A photo shows instead.`, 'off'];
      return [v.hideAfter ? `Showing until ${nice(v.hideAfter)}` : 'Showing', 'on'];
    }
    function renderVideo() {
      const f = $('[data-video-form]') as HTMLFormElement, v = state.homeVideo || {};
      field(f, 'show').checked = !!v.show;
      for (const k of ['youtube', 'title', 'text', 'buttonText', 'buttonLink', 'hideAfter']) field(f, k).value = v[k] || '';
      photoField($('[data-photo="cover"]', f), v.cover || null);
      (f as Any)._video = null; (f as Any)._removeUpload = false; $('[data-home-video-name]').textContent = '';
      const note = $('[data-upload-note]');
      note.hidden = !(v.video && !v.youtube);
      note.innerHTML = 'It plays an uploaded video now. Upload a new one or paste a YouTube link to replace it, or <button type="button" class="qe-link" data-rm-upload>remove it</button>.';
      const rm = $('[data-rm-upload]'); if (rm) rm.onclick = () => { (f as Any)._removeUpload = true; dirty = true; note.textContent = 'The uploaded video will be removed when you save.'; };
      const [t, c] = videoStatus(); pill($('[data-video-status]'), t, c);
    }
    ($('[data-home-video]') as HTMLInputElement).addEventListener('change', async (e) => {
      const input = e.currentTarget as HTMLInputElement, file = input.files?.[0]; input.value = '';
      if (!file) return;
      const f = $('[data-video-form]') as HTMLFormElement, label = $('[data-home-video-name]');
      label.textContent = 'Uploading… 0%. Keep this page open.';
      const url = await uploadVideo(file, (p) => (label.textContent = `Uploading… ${p}%. Keep this page open.`));
      if (!url) { label.textContent = ''; return; }
      (f as Any)._video = url; (f as Any)._removeUpload = false; dirty = true;
      field(f, 'youtube').value = '';
      const box = $('[data-photo="cover"]', f) as Any;
      if (!box.value) { label.textContent = 'Making a cover photo…'; const c = await coverFromVideo(file); if (c) photoField(box, c.path, c.data); }
      label.textContent = `✓ ${file.name} is uploaded. Tap "Save video" to put it on the homepage.`;
    });
    $('[data-video-form]').addEventListener('submit', async (e) => {
      e.preventDefault(); const f = e.currentTarget as HTMLFormElement;
      const data: Any = Object.fromEntries(new FormData(f).entries());
      data.show = field(f, 'show').checked; data.cover = ($('[data-photo="cover"]', f) as Any).value; data.removeUpload = !!(f as Any)._removeUpload; data.video = (f as Any)._video || null;
      if (data.show && !data.youtube && !data.video && (!state.homeVideo?.video || data.removeUpload)) return toast('To show a video, upload one or paste a YouTube link first.', true);
      await busy($('button[type=submit]', f) as HTMLButtonElement, async () => { saved(await api('saveVideo', { data })); });
    });

    // ---------------------------------------------------------------- hours (one set of controls; the text writes itself)
    const DAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
    const FULL: Record<string, string> = { Mon: 'Monday', Tue: 'Tuesday', Wed: 'Wednesday', Thu: 'Thursday', Fri: 'Friday', Sat: 'Saturday', Sun: 'Sunday' };
    const hourLabel = (h: number) => (h === 0 || h === 24 ? 'midnight' : h === 12 ? 'noon' : h < 12 ? `${h}am` : `${h - 12}pm`);
    const runs = (set: string[]) => {
      const out: string[][] = []; let cur: string[] = [];
      DAYS.forEach((d) => { if (set.includes(d)) cur.push(d); else if (cur.length) { out.push(cur); cur = []; } });
      if (cur.length) out.push(cur);
      return out.map((r) => (r.length === 1 ? FULL[r[0]] : r.length === 2 ? `${r[0]} and ${r[1]}` : `${r[0]} to ${r[r.length - 1]}`));
    };
    const linesFor = (open: string[], o: number, c: number) => [
      ...runs(open).map((d) => ({ days: d, hours: `${hourLabel(o)} to ${hourLabel(c)}` })),
      ...runs(DAYS.filter((d) => !open.includes(d))).map((d) => ({ days: d, hours: 'Closed' })),
    ];
    // Read days and times back out of lines like "Mon to Sat: 10am to 4pm"
    function parseLines(rows: Any[]): { days: string[]; open: number; close: number } | null {
      const toH = (t: string) => { const m = /(\d{1,2})(?::\d\d)?\s*(am|pm)|noon|midnight/i.exec(t); if (!m) return NaN; if (/noon/i.test(m[0])) return 12; if (/midnight/i.test(m[0])) return 24; let h = +m[1] % 12; if (/pm/i.test(m[2])) h += 12; return h; };
      const dayIdx = (w: string) => DAYS.findIndex((d) => w.trim().toLowerCase().startsWith(d.toLowerCase()));
      const days: string[] = []; let open = NaN, close = NaN;
      for (const r of rows || []) {
        if (/closed/i.test(r.hours)) continue;
        const isRange = /\s(to|-|through)\s/i.test(r.days);
        const parts = String(r.days).split(/\s+(?:to|-|through)\s+|\s*,\s*|\s+and\s+/i).map(dayIdx);
        if (isRange && parts.length === 2 && parts[0] >= 0 && parts[1] >= 0) for (let i = parts[0]; i <= parts[1]; i++) days.push(DAYS[i]);
        else parts.forEach((i) => i >= 0 && days.push(DAYS[i]));
        const [a, b] = String(r.hours).split(/\s+(?:to|-)\s+/i);
        open = toH(a || ''); close = toH(b || '');
      }
      return days.length && !isNaN(open) && !isNaN(close) ? { days, open, close } : null;
    }
    const readBlock = (key: string) => {
      const box = $(`[data-hours="${key}"]`);
      return { days: $$<HTMLInputElement>('[data-days] input:checked', box).map((i) => i.value), open: +($('[data-open]', box) as HTMLSelectElement).value, close: +($('[data-close]', box) as HTMLSelectElement).value };
    };
    function hoursBlock(key: 'shop' | 'drop', v: { days: string[]; open: number; close: number }) {
      const box = $(`[data-hours="${key}"]`);
      $('[data-days]', box).innerHTML = DAYS.map((d) => `<label class="qe-day"><input type="checkbox" value="${d}" ${v.days.includes(d) ? 'checked' : ''} /> ${d}</label>`).join('');
      for (const [sel, val] of [['[data-open]', v.open], ['[data-close]', v.close]] as const) {
        const s = $(sel, box) as HTMLSelectElement;
        s.innerHTML = Array.from({ length: 19 }, (_, i) => i + 5).map((h) => `<option value="${h}">${hourLabel(h)}</option>`).join('');
        s.value = String(val);
      }
      const say = () => { const r = readBlock(key); $('[data-says]', box).textContent = 'On the site: ' + linesFor(r.days, r.open, r.close).map((l) => `${l.days}: ${l.hours}`).join(' · '); };
      box.oninput = box.onchange = say; say();
    }
    function renderHours() {
      const s = state.settings || {}, f = $('[data-hours-form]') as HTMLFormElement;
      hoursBlock('shop', { days: s.openDays?.length ? s.openDays : ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'], open: s.openHour ?? 10, close: s.closeHour ?? 19 });
      hoursBlock('drop', parseLines(s.donateHours) || { days: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'], open: 10, close: 16 });
      field(f, 'phone').value = s.phone || ''; field(f, 'email').value = s.email || '';
    }
    const hoursSummary = () => { const l = (state.settings?.shopHours || []).find((h: Any) => !/closed/i.test(h.hours)); return l ? `Shop: ${l.days}, ${l.hours}` : ''; };
    $('[data-hours-form]').addEventListener('submit', async (e) => {
      e.preventDefault(); const f = e.currentTarget as HTMLFormElement;
      const shop = readBlock('shop'), drop = readBlock('drop');
      if (shop.close <= shop.open || drop.close <= drop.open) return toast('Closing time needs to be after opening time.', true);
      if (!shop.days.length) return toast('Tick at least one day the shop is open.', true);
      const data = { shopHours: linesFor(shop.days, shop.open, shop.close), donateHours: linesFor(drop.days, drop.open, drop.close), openDays: shop.days, openHour: shop.open, closeHour: shop.close, phone: field(f, 'phone').value, email: field(f, 'email').value };
      await busy($('button[type=submit]', f) as HTMLButtonElement, async () => { saved(await api('saveHours', { data })); });
    });

    // ---------------------------------------------------------------- home tiles
    function renderTiles() {
      const live = (state.events || []).filter((e: Any) => statusOf(e.startDate || '', e.endDate || e.startDate || '')[1] !== 'off');
      const now = live.filter((e: Any) => statusOf(e.startDate, e.endDate || e.startDate)[1] === 'on').length;
      const status: Record<string, [string, string]> = {
        events: [now ? `${now} happening now, ${live.length - now} more coming` : `${live.length} coming up`, live.length ? 'on' : 'warn'],
        ribbon: ribbonStatus(),
        tags: tagStatus(),
        gallery: galleryStatus(),
        slides: slidesStatus(state.slides || []),
        video: videoStatus(),
        hours: [hoursSummary(), ''],
      };
      $$('[data-status-for]').forEach((el) => { const [t, c] = status[el.dataset.statusFor!] || ['', '']; el.textContent = t; el.className = 'qe-home-status ' + c; });
      $('[data-tiles-home]').hidden = false; $('[data-loading]').hidden = true;
    }

    // ---------------------------------------------------------------- load
    async function load() {
      const j = await api('load');
      if (!j.ok) { if (j.error && !/log in/i.test(j.error)) $('[data-loading]').textContent = j.error; return; }
      state = j;
      weeks = (j.tagSale?.weeks || []).map((w: Any) => ({ ...w }));
      gallery = (j.gallery?.items || []).map((g: Any) => ({ ...g }));
      slides = (j.slides || []).map((s: Any) => ({ ...s, primary: { ...(s.primary || {}) }, secondary: { ...(s.secondary || {}) } }));
      field($('[data-tag-form]') as HTMLFormElement, 'enabled').checked = !!j.tagSale?.enabled;
      renderEvents(); renderRibbon(); renderWeeks(); renderGallery(); renderSlides(); renderVideo(); renderHours(); renderTiles();
      dirty = false;
    }

    (async () => {
      const j = await api('check');
      if (j.ok) showApp(); else { showLogin(); if (j.error) { const err = $('[data-login-error]'); err.textContent = j.error; err.hidden = false; } }
    })();
  </script>

