---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found">
  <section class="section">
    <div class="wrap narrow" style="text-align:center">
      <img src="/images/brand/tag-blue.png" alt="" width="160" style="margin:0 auto 24px" />
      <p class="eyebrow">404</p>
      <h1 class="h2" style="margin-bottom:16px">This treasure is still hidden.</h1>
      <p class="lead">We could not find that page.</p>
      <div class="btn-row" style="justify-content:center"><a class="btn btn-red" href="/">Go home</a><a class="btn btn-outline" href="/donate">Donate goods</a></div>
    </div>
  </section>
</Layout>
