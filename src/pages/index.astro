---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Watermark from '../components/Watermark.astro';

import VisitCard from '../components/VisitCard.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostRow from '../components/PostRow.astro';
import Stories from '../components/Stories.astro';
import Newsletter from '../components/Newsletter.astro';
import PartnersStrip from '../components/PartnersStrip.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import VideoFeature from '../components/VideoFeature.astro';
import { reader, getPosts } from '../lib/content';
const settings = await reader.singletons.settings.read();
const donate = await reader.singletons.donate.read();

const home = await reader.singletons.home.read();
const posts = await getPosts();
// Pinned posts first, then the rest soonest-first. The page script hides anything that ended more than 2 days ago.
const byStart = [...posts].sort((a, b) => (a.startDate ?? '').localeCompare(b.startDate ?? ''));
const candidates = [...posts.filter((p) => p.pinned), ...byStart.filter((p) => !p.pinned && p.type !== 'news')].slice(0, 6);
const featured = candidates[0] ?? posts[0];
const others = byStart.slice(0, 12);
---
<Layout>
  <Hero slides={home?.slides ?? []} />
  <VisitCard />

  <VideoFeature />

  <!-- Three ways in -->
  <section class="section has-wm" style="--pb:40px">
    <Watermark variant="badge" tone="dark" opacity={0.045} rotate={-4} style="width:min(1100px,110vw);left:50%;top:50%;margin-left:min(-550px,-55vw);margin-top:-390px" />
    <div class="wrap">
      <div class="section-head reveal">
        <div style="max-width:640px">
          <p class="eyebrow">How you can help</p>
          <h2 class="h2">Donate, shop, or work with us.</h2>
        </div>
        <p class="muted" style="margin:0;max-width:380px;font-size:17px">Most of all, we run on donated goods. They are where the work begins.</p>
      </div>
      <div class="grid3">
        <article class="card pad lift path reveal" style="background:var(--red);color:#fff">
          <img class="tag" src="/images/brand/tag-blue.png" alt="" width="150" />
          <span class="label" style="color:#ffd9cc">Start here</span>
          <h3 class="h3" style="font-size:clamp(27px,7.0vw,34px);max-width:220px">Donate your goods</h3>
          <p style="margin:0;color:#fbe9ec">Clothing, furniture, housewares, books and toys. Drop off at the back of the store.</p>
          <div class="links">
            <a class="linkrow" href="/donate#dropoff">Drop-off details <span aria-hidden="true">→</span></a>
            <a class="linkrow" href="/donate#pickup">{donate?.pickupsPaused ? 'Furniture and large items' : 'Schedule a furniture pickup'} <span aria-hidden="true">→</span></a>
            <a class="linkrow" href="/donate#bulk">Business or bulk donations <span aria-hidden="true">→</span></a>
            <a class="linkrow" href="/donate#accept">What we accept <span aria-hidden="true">→</span></a>
          </div>
        </article>
        <article class="card pad lift path outline reveal" style="transition-delay:80ms">
          <span class="label" style="color:var(--red)">Thrift with purpose</span>
          <h3 class="h3" style="font-size:clamp(27px,7.0vw,34px)">Shop the store</h3>
          <p class="muted" style="margin:0">New items go out on the floor every day, and what you spend supports the work.</p>
          <div class="links">
            <a class="linkrow linkrow-ink" href="/visit">Hours and directions <span aria-hidden="true">→</span></a>
            <a class="linkrow linkrow-ink" href="/news">Sales and events <span aria-hidden="true">→</span></a>
            {settings?.ebayUrl && <a class="linkrow linkrow-ink" href={settings.ebayUrl}>Shop from home <span aria-hidden="true">→</span></a>}
            <a class="linkrow linkrow-ink" href="/loyalty">Loyalty program <span aria-hidden="true">→</span></a>
          </div>
        </article>
        <article class="card pad lift path reveal" style="background:var(--blue);transition-delay:160ms">
          <span class="label">Employment program</span>
          <h3 class="h3" style="font-size:clamp(27px,7.0vw,34px)">Work with us</h3>
          <p style="margin:0">Looking for a fresh start, or know someone who is? Pastors, case workers and families can refer directly.</p>
          <div class="links">
            <a class="linkrow linkrow-ink" href="/work-with-us#apply">Apply for a job <span aria-hidden="true">→</span></a>
            <a class="linkrow linkrow-ink" href="/work-with-us#refer">Refer someone <span aria-hidden="true">→</span></a>
            <a class="linkrow linkrow-ink" href="/work-with-us#volunteer">Volunteer <span aria-hidden="true">→</span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Inside the store -->
  <section class="section-tight" style="--pt:70px;--pb:0px">
    <div class="wrap">
      <PhotoStrip />
      <div style="text-align:right;margin-top:14px"><a href="/gallery" style="font-weight:700">See the gallery →</a></div>
    </div>
  </section>

  <!-- The engine -->
  <section class="engine section has-wm" style="margin-top:80px">
    <Watermark variant="badge" tone="light" opacity={0.07} rotate={-8} style="width:640px;right:-120px;bottom:-60px" />
    <div class="wrap" style="position:relative">
      <div class="reveal" style="max-width:760px">
        <p class="eyebrow">What your donation makes possible</p>
        <h2 class="h2">{home?.engineTitle}</h2>
        <p class="lead" style="margin:22px 0 0">{home?.engineIntro}</p>
      </div>
      <div class="steps">
        <div class="string" aria-hidden="true"></div>
        <div class="step reveal"><div class="num" style="background:var(--red)">01</div><h3>You donate</h3><p>The things you no longer need become the store's entire inventory.</p></div>
        <div class="step reveal" style="transition-delay:100ms"><div class="num" style="background:var(--orange)">02</div><h3>Our team gets to work</h3><p>Our team sorts, prices and sells it. These are paid jobs, and most of the hours go to people in recovery and re-entry.</p></div>
        <div class="step reveal" style="transition-delay:200ms"><div class="num" style="background:var(--blue);color:var(--ink)">03</div><h3>Neighbors find treasures</h3><p>Shoppers get good everyday things at low prices, and less ends up in a landfill.</p></div>
        <div class="step reveal" style="transition-delay:300ms"><div class="num" style="background:var(--toffee);color:var(--ink)">04</div><h3>Lives are rebuilt</h3><p>A steady job and a team to show up for. For someone in recovery, that counts for a lot.</p></div>
      </div>
      <div class="btn-row" style="margin-top:64px;align-items:center">
        <a class="btn btn-red" href="/donate">Donate your goods</a>
        <a class="btn btn-ghost" href="/our-story">Read our full story</a>
        <p style="margin:0 0 0 8px;font-size:15px;color:#b9ae9f">Serving the Twin Cities since 2008. A ministry of Masterworks of Minneapolis, founded in 1991.</p>
      </div>
    </div>
  </section>

  <!-- News and events -->
  {featured && (
    <section class="section" style="--pb:20px">
      <div class="wrap">
        <div class="section-head reveal">
          <div>
            <p class="eyebrow">News and events</p>
            <h2 class="h2">What is happening at the store.</h2>
          </div>
          <div class="btn-row"><a class="btn btn-red" href="/news#calendar">Sales calendar</a><a class="btn btn-outline" href="/news">All news and events</a></div>
        </div>
        <div class="events">
          <div class="reveal" data-when-pick>{(candidates.length ? candidates : [featured]).map((c, i) => <div data-pick-item hidden={i > 0}><FeaturedPost post={c} /></div>)}</div>
          <div style="display:flex;flex-direction:column;gap:12px" data-when-list data-limit="4">
            <p class="label" style="margin:0 0 4px;color:var(--ink-2)">Coming up</p>
            {others.map((p) => <PostRow post={p} />)}
            <p data-empty hidden class="card" style="margin:0;padding:24px">More events coming soon. Sign up below to hear first.</p>
          </div>
        </div>
      </div>
    </section>
  )}

  <PartnersStrip />
  <Stories homeOnly />
  <Newsletter />
</Layout>

