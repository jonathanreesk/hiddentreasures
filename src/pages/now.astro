---
// "What's on the website right now": a staff page showing everything that is live,
// with an Edit button for each item that opens it in the editor.
import Layout from '../layouts/Layout.astro';
import { reader, getPosts, img, dateRange, typeLabel } from '../lib/content';

// Edit buttons open the staff Quick edits page (/edit), which asks for the shared password
const ed = '/edit';
const edit = {
  ribbon: '/edit#ribbon',
  video: '/edit#video',
  tag: '/edit#tags',
  hours: '/edit#hours',
  newEvent: '/edit#events',
  event: (_slug: string) => '/edit#events',
};

const ann = await reader.singletons.announcement.read();
const video = await reader.singletons.homeVideo.read();
const tag = await reader.singletons.tagSale.read();
const settings = await reader.singletons.settings.read();
const posts = (await getPosts()).sort((a, b) => (a.startDate ?? '').localeCompare(b.startDate ?? ''));
const weeks = (tag?.weeks ?? []).filter((w) => w.start && w.end);
const tagHex: Record<string, string> = { blue: '#3e5f9e', green: '#3f8f4f', red: '#a33749', yellow: '#f2c94c', orange: '#c45d3b', purple: '#6b4c9a', pink: '#e58fb2', white: '#ffffff' };
---
<Layout title="What's on the site right now" noindex>
  <section class="section now-page" style="--pt:56px">
    <div class="wrap" style="max-width:980px">
      <p class="eyebrow">For store staff</p>
      <h1 class="h2" style="margin:0">What's on the website right now</h1>
      <p class="lead" style="margin:14px 0 0">Everything below is live on hiddentreasuresmn.org. Tap <strong>Edit</strong> to change it. Changes show up here and on the site about a minute after you save.</p>
      <div class="btn-row" style="margin-top:24px">
        <a class="btn btn-red" href={edit.newEvent}>+ Add an event or sale</a>
        <a class="btn btn-outline" href={ed}>Open Quick edits</a>
      </div>

      <!-- Top ribbon -->
      <article class="now-card">
        <header><h2>📣 Top ribbon</h2><a class="now-edit" href={edit.ribbon}>Edit</a></header>
        {ann?.enabled && ann?.message
          ? <div><span class="now-pill on">Showing</span><p class="now-ribbon"><strong>{ann.label}</strong> {ann.message} {ann.linkText && <u>{ann.linkText}</u>}</p></div>
          : <div><span class="now-pill off">Hidden</span><p class="muted">No ribbon at the top of the site right now.</p></div>}
      </article>

      <!-- Events -->
      <article class="now-card">
        <header><h2>📅 Events, sales and closures</h2><a class="now-edit" href={edit.newEvent}>+ Add</a></header>
        <p class="muted" style="margin:0 0 14px">Events disappear from the site 2 days after they end. Nothing to delete.</p>
        <ul class="now-list" data-now-events>
          {posts.map((p) => (
            <li data-start={p.startDate} data-end={p.endDate || p.startDate} data-type={p.type} data-pinned={p.pinned ? '1' : undefined}>
              <span class="now-pill" data-status>…</span>
              <div class="now-main">
                <strong>{p.title}</strong>
                <span class="muted">{typeLabel[p.type]} · {dateRange(p.startDate!, p.endDate)}{p.pinned && ' · Featured on the homepage'}</span>
              </div>
              <a class="now-edit" href={edit.event(p.slug)}>Edit</a>
            </li>
          ))}
        </ul>
        <button type="button" class="now-more" data-show-old hidden>Show older events</button>
      </article>

      <!-- Tag sale -->
      <article class="now-card">
        <header><h2>🏷️ Color tag sale</h2><a class="now-edit" href={edit.tag}>Edit</a></header>
        {!tag?.enabled && <div><span class="now-pill off">Hidden</span><p class="muted">The tag sale banner is turned off.</p></div>}
        {tag?.enabled && (
          <ul class="now-list" data-now-weeks>
            {weeks.map((w) => (
              <li data-start={w.start} data-end={w.end}>
                <span class="now-pill" data-status>…</span>
                <span class="now-swatch" style={`background:${tagHex[w.color] ?? '#ccc'}`}></span>
                <div class="now-main"><strong>{w.color.charAt(0).toUpperCase() + w.color.slice(1)} tags {w.discount}</strong><span class="muted">{dateRange(w.start!, w.end)}</span></div>
              </li>
            ))}
            <li data-none hidden><span class="now-pill warn">Missing</span><div class="now-main"><strong>No tag color set for this week</strong><span class="muted">Add this week's color so the banner shows.</span></div></li>
          </ul>
        )}
      </article>

      <!-- Homepage video -->
      <article class="now-card">
        <header><h2>🎬 Homepage video</h2><a class="now-edit" href={edit.video}>Edit</a></header>
        {video?.show && (video?.video || video?.youtube)
          ? <div class="now-video">{video?.cover && <img src={img(video.cover)} alt="" width="240" height="135" loading="lazy" />}<div><span class="now-pill on">Showing</span><p style="margin:8px 0 0"><strong>{video.title}</strong></p><p class="muted" style="margin:4px 0 0">{video.youtube ? 'YouTube or Vimeo link' : 'Uploaded video'}</p></div></div>
          : <div><span class="now-pill off">Hidden</span><p class="muted">No video on the homepage right now.</p></div>}
      </article>

      <!-- Hours -->
      <article class="now-card">
        <header><h2>🕘 Hours and contact</h2><a class="now-edit" href={edit.hours}>Edit</a></header>
        <div class="now-hours">
          <div><p class="label">Shop</p>{(settings?.shopHours ?? []).map((h) => <p>{h.days}: <strong>{h.hours}</strong></p>)}</div>
          <div><p class="label">Donation drop-off</p>{(settings?.donateHours ?? []).map((h) => <p>{h.days}: <strong>{h.hours}</strong></p>)}</div>
          <div><p class="label">Contact</p><p>{settings?.phone}</p><p>{settings?.email}</p></div>
        </div>
      </article>
    </div>
  </section>
</Layout>

<script>
  const today = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Chicago' });
  const days = (a: string, b: string) => Math.round((Date.parse(a + 'T00:00:00Z') - Date.parse(b + 'T00:00:00Z')) / 86400000);
  const set = (el: HTMLElement, text: string, cls: string) => { const s = el.querySelector<HTMLElement>('[data-status]'); if (s) { s.textContent = text; s.className = 'now-pill ' + cls; } };

  // Events: same rules as the public site
  const rows = [...document.querySelectorAll<HTMLElement>('[data-now-events] li')];
  let old = 0;
  rows.forEach((li) => {
    const start = li.dataset.start || '', end = li.dataset.end || start;
    if (start <= today && today <= end) set(li, start === end ? 'Today' : 'Happening now', 'on');
    else if (start > today) set(li, days(start, today) === 1 ? 'Tomorrow' : 'Coming up', 'soon');
    else if (days(today, end) <= 2) set(li, 'Just ended', 'ended');
    else { set(li, 'Not showing (ended)', 'off'); li.hidden = true; li.classList.add('old'); old++; }
  });
  const btn = document.querySelector<HTMLButtonElement>('[data-show-old]');
  if (btn && old) { btn.hidden = false; btn.textContent = `Show ${old} older event${old > 1 ? 's' : ''}`; btn.onclick = () => { rows.forEach((r) => (r.hidden = false)); btn.hidden = true; }; }

  // Tag sale weeks: highlight this week, hide past weeks
  const weeks = [...document.querySelectorAll<HTMLElement>('[data-now-weeks] li[data-start]')];
  let current = false;
  weeks.forEach((li) => {
    const start = li.dataset.start || '', end = li.dataset.end || '';
    if (start <= today && today <= end) { set(li, 'This week', 'on'); current = true; }
    else if (start > today) set(li, 'Coming up', 'soon');
    else li.hidden = true;
  });
  const none = document.querySelector<HTMLElement>('[data-now-weeks] [data-none]');
  if (none && !current) { none.hidden = false; none.parentElement?.prepend(none); }
</script>

<style>
  .now-card { margin-top: 28px; padding: 26px 28px; background: #fffdf9; border-radius: 22px; box-shadow: 0 1px 0 rgba(35,31,27,.06), 0 14px 36px rgba(35,31,27,.06); }
  .now-card header { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
  .now-card h2 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: 24px; }
  .now-card p { margin: 0; }
  .now-edit { display: inline-flex; align-items: center; min-height: 40px; padding: 0 18px; border-radius: 999px; background: var(--ink); color: #fff; font-weight: 700; font-size: 14px; text-decoration: none; white-space: nowrap; }
  .now-edit:hover { background: var(--red); color: #fff; }
  .now-pill { display: inline-block; padding: 3px 10px; border-radius: 999px; font-family: var(--mono); font-size: 11.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; background: var(--sand); color: var(--muted); }
  .now-pill.on { background: #e4f2e8; color: #205a33; }
  .now-pill.soon { background: #fff4c7; color: #6b5300; }
  .now-pill.warn { background: #fde3e3; color: #8a1f2b; }
  .now-pill.ended, .now-pill.off { background: var(--sand); color: var(--muted); }
  .now-ribbon { margin-top: 10px !important; padding: 12px 16px; border-radius: 12px; background: var(--red); color: #fff; }
  .now-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .now-list li { display: flex; align-items: center; gap: 14px; padding: 12px 14px; border-radius: 14px; background: var(--cream); }
  .now-list li[hidden] { display: none; }
  .now-list li.old { opacity: .6; }
  .now-main { flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .now-swatch { width: 22px; height: 22px; border-radius: 50%; box-shadow: inset 0 0 0 2px rgba(0,0,0,.12); flex: none; }
  .now-more { margin-top: 12px; background: none; border: 0; color: var(--red); font-weight: 700; cursor: pointer; padding: 6px 0; }
  .now-video { display: flex; gap: 18px; align-items: center; }
  .now-video img { width: 200px; height: auto; border-radius: 12px; object-fit: cover; }
  .now-hours { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .now-hours .label { margin-bottom: 6px !important; color: var(--ink-2); }
  @media (max-width: 700px) {
    .now-card { padding: 20px 18px; }
    .now-list li { flex-wrap: wrap; }
    .now-hours { grid-template-columns: 1fr; }
    .now-video { flex-direction: column; align-items: flex-start; }
  }
</style>
