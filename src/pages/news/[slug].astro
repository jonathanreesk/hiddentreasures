---
import Layout from '../../layouts/Layout.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, paragraphs, dateRange, typeLabel, videoEmbed, reader } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const embed = videoEmbed(post.videoUrl);
const more = (await getPosts()).filter((p) => p.slug !== post.slug).slice(0, 3);
const s = await reader.singletons.settings.read();
const start = post.startDate!.replace(/-/g, '');
const endD = new Date((post.endDate || post.startDate!) + 'T00:00:00Z');
endD.setUTCDate(endD.getUTCDate() + 1);
const end = endD.toISOString().slice(0, 10).replace(/-/g, '');
const gcal = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(post.title)}&dates=${start}/${end}&details=${encodeURIComponent((post.timeText ? post.timeText + '. ' : '') + (post.summary || ''))}&location=${encodeURIComponent(`${s?.addressLine1}, ${s?.addressLine2}`)}`;
---
<Layout title={post.title} description={post.summary || undefined} image={post.image || undefined}>
  <section class="page-hero">
    {post.image && <img class="bg" src={post.image} alt="" />}
    <div class="wrap">
      <a href="/news" style="color:#fff;font-weight:700;display:inline-flex;min-height:44px;align-items:center">← All news and events</a>
      <p class="eyebrow pop" style="margin-top:18px">{post.badge || typeLabel[post.type]}</p>
      <h1 class="h1 pop" style="max-width:860px">{post.title}</h1>
      <p class="lead pop">{dateRange(post.startDate!, post.endDate)}{post.timeText ? ` · ${post.timeText}` : ''}{post.location ? ` · ${post.location}` : ''}</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap split">
      <div>
        {embed && <div class="video reveal" style="margin-bottom:32px"><iframe src={embed} title={`Video: ${post.title}`} loading="lazy" allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe></div>}
        {!embed && post.image && <img src={post.image} alt="" class="reveal" style="border-radius:var(--radius);margin-bottom:32px;width:100%" />}
        <div class="prose">
          {post.summary && <p class="serif" style="font-size:clamp(19px,4.9vw,24px);line-height:1.45">{post.summary}</p>}
          {paragraphs(post.body).map((p) => <p>{p}</p>)}
        </div>
        {post.type !== 'news' && (
          <div class="btn-row" style="margin-top:12px">
            <a class="btn btn-ink" href={gcal}>Add to Google Calendar</a>
            {s?.mapsUrl && <a class="btn btn-outline" href={s.mapsUrl}>Get directions</a>}
          </div>
        )}
      </div>
      {more.length > 0 && (
        <aside style="display:flex;flex-direction:column;gap:12px">
          <p class="eyebrow">More from the store</p>
          {more.map((p) => <PostRow post={p} />)}
        </aside>
      )}
    </div>
  </section>
</Layout>
