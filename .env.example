# Copy these into Vercel > Project > Settings > Environment Variables.
# Never commit real values to GitHub.

# --- Forms (SendGrid) ---
SENDGRID_API_KEY=
FORM_TO_EMAIL=hello@hiddentreasuresmn.org
FORM_FROM_EMAIL=website@hiddentreasuresmn.org

# --- Editor: Keystatic Cloud (staff sign in with email) ---
# Your Keystatic Cloud project as team/project. When set, this is used instead of GitHub logins.
PUBLIC_KEYSTATIC_CLOUD_PROJECT=

# --- Editor: GitHub mode (only if not using Keystatic Cloud) ---
# Your repo as owner/name. Setting this switches the editor from "save to my computer" to "save to GitHub".
PUBLIC_GITHUB_REPO=
# The next four are created for you by the Keystatic setup wizard (see SETUP.md, step 4).
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
